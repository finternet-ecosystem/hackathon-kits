# Copy to .env and fill in. Never commit real keys.
#
# Get your key: Developer Portal → Hackathon → Enable Hackathon API
# (test-mode key on a dedicated hackathon org; shown once)

HACKATHON_ORG_API_KEY=sk_test_YOUR_HACKATHON_KEY

# Shared Vouch sandbox (default for hackathons):
API_BASE_URL=https://cdir.vouch.finance/api/v1

# Local backend instead:
# API_BASE_URL=http://localhost:9393/api/v1

# Optional: Kit 3 watch-chain.ts RPC (defaults to local Hardhat)
# RPC_URL=http://127.0.0.1:8545

# Kit 4 approve-proposal.ts only. Approving a proposal needs a different actor
# than the one that proposed, so it uses your portal session JWT, not the key
# above. Portal -> DevTools -> Network -> any /api/* request -> copy the value
# after "Authorization: Bearer ". Short-lived; recopy on a 401.
# VOUCH_PORTAL_TOKEN=

# Integration tests only (organizers). Not needed for seed/replay.
# HACKATHON_ADMIN_KEY=
