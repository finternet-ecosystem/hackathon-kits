{
  "name": "vouch-hackathon-kits",
  "version": "1.0.0",
  "description": "Vouch hackathon sandbox kits: seed and replay four supervision scenarios against a live Vouch backend using only an API key.",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "seed": "tsx seed-kit.ts",
    "run": "tsx run-stream.ts",
    "watch-chain": "tsx watch-chain.ts",
    "test": "tsx --test __tests__/*.test.ts",
    "test:integration": "tsx --test __tests__/*.integration.test.ts",
    "test:all": "tsx --test __tests__/*.test.ts __tests__/*.integration.test.ts"
  },
  "dependencies": {
    "ethers": "^6.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "@types/node": "^24.0.0"
  }
}
