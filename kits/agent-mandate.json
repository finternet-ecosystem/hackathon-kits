{
  "kitId": "agent-mandate",
  "title": "Agent Spending Mandate",
  "track": "Agent Spending Mandate",
  "description": "A procurement AI agent (parent) delegates budgeted, category- and merchant-restricted spending mandates to three sub-agents (children), one of which is deliberately under-funded relative to its siblings. A ~90-transaction stream exercises the mandate's guardrails: per-tx budget cap, merchant counterparty allowlist, category allowlist, business-hours window, and tx velocity \u2014 plus a delegation-chain overspend by the restricted child.",
  "program": {
    "slugPrefix": "agent-mandate",
    "name": "Procurement Mandates",
    "currency": "USD",
    "currencySymbol": "$",
    "balanceModel": "fixed",
    "backingType": "usdc_onchain",
    "settings": {
      "allowSelfEnrollment": true,
      "defaultExpiryDays": 90
    }
  },
  "policy": {
    "tiers": [
      {
        "tier": 1,
        "label": "Parent Mandate",
        "value": 100000,
        "expiryDays": 90,
        "categories": [
          "OFFICE",
          "LOGISTICS",
          "SOFTWARE",
          "TRAVEL"
        ]
      },
      {
        "tier": 2,
        "label": "Sub-Agent Mandate",
        "value": 20000,
        "expiryDays": 90,
        "categories": [
          "OFFICE",
          "LOGISTICS",
          "SOFTWARE",
          "TRAVEL"
        ]
      },
      {
        "tier": 3,
        "label": "Restricted Sub-Agent Mandate",
        "value": 5000,
        "expiryDays": 90,
