  "hooks": [
    {
      "name": "Counterparty + budget + business-hours gate",
      "event": "redemption",
      "phase": "pre",
      "type": "rule",
      "description": "Per-tx cap $2,000, merchant must be one of the 10 approved counterparties, and the transaction must fall within business hours (09:00-17:00).",
      "ruleConfig": {
        "all": [
          {
            "field": "merchant.id",
            "op": "in",
            "value": [
              {
                "$merchantRef": "m1"
              },
              {
                "$merchantRef": "m2"
              },
              {
                "$merchantRef": "m3"
              },
              {
                "$merchantRef": "m4"
              },
              {
                "$merchantRef": "m5"
              },
              {
                "$merchantRef": "m6"
              },
              {
                "$merchantRef": "m7"
              },
              {
                "$merchantRef": "m8"
              },
              {
                "$merchantRef": "m9"
              },
              {
                "$merchantRef": "m10"
              }
            ]
          },
          {
            "field": "cart.total",
            "op": "lte",
            "value": 2000
          },
          {
            "field": "time.hour",
            "op": "between",
            "value": [
              9,
              17
            ]
          }
        ]
      },
      "effect": "deny",
      "failureBehavior": "block"
    },
    {
      "name": "Velocity gate (max ~5 payments / 10 min per agent)",
      "event": "redemption",
      "phase": "pre",
      "type": "rate_limit",
      "description": "Per-beneficiary (per-agent) velocity cap. Also the mechanism that catches split-payment structuring. This window is measured in real wall-clock time, independent of X-Sim-Time. See kit README 'Known platform limitations'. Per-actor scenario counts below are deliberately kept at or under this limit so a fast (--speed) automated replay does not self-trip the compliant baseline; only the dedicated split-payment-structuring scenario is sized to exceed it.",
      "actionConfig": {
        "windowMs": 600000,
        "limit": 10,
        "metric": "count"
      },
      "effect": "deny",
      "failureBehavior": "block"
    }
  ],
